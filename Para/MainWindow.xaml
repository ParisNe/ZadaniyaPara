<Window x:Class="Para.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Para"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFE4E1" BorderBrush="Black" BorderThickness="0,0,0,1">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                        x:Name="BackButton" 
                        Content="Назад" 
                        Width="100"
                        Height="35" Click="BackButton_Click"
                        Background="White"/>

                <TextBlock Text="Пицца у гордова"
                           x:Name="Name"
                           Grid.Column="1"
                           HorizontalAlignment="Center"
                           FontSize="18"/>

            </Grid>
        </Border>

        <Frame Grid.Row="1" 
               x:Name="MainFrame" 
               Source="Pages/MainPage.xaml"
               NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
