<Page x:Class="Para.Pages.ConfirmPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Para.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ConfirmPage" Background="#FFFFC0CB">

    <StackPanel>
        <TextBlock Text="ВАШ ЗАКАЗ"
        HorizontalAlignment="Center"
        FontSize="22" FontWeight="Bold"/>
        
        <TextBlock x:Name="PizzaItog"
        FontSize="20" Text="Ваш выбор:" Margin="5"/>
        <TextBlock x:Name="SizeItog"
        FontSize="20" Text="Размер:" Margin="5"/>
        <TextBlock x:Name="DopItog"
        FontSize="20" Text="Доп:" Margin="5"/>

        <TextBlock x:Name="Itog" Text="Итог:" FontSize="20"/>

        <TextBlock Margin="5" FontSize="20"
        Text="Имя клиента:"/>
        
        <TextBox Margin="0,0,5,0"
        Height="35" Width="350" FontSize="20"
        HorizontalAlignment="Left" x:Name="NameUser"/>

        <ComboBox x:Name="cbOplata" Margin="0,5,0,5" Height="40" Width="350" HorizontalAlignment="Left">
            <TextBlock FontSize="20" Text="Безнал"/>
            <TextBlock FontSize="20" Text="нал"/>
            <TextBlock FontSize="20" Text="анал"/>
            <TextBlock FontSize="20" Text="натура"/>
        </ComboBox>

        <Button Content="Подтвердить"
         FontWeight="Bold" Background="White"
         FontSize="20" Height="45" Width="200"
        Margin="10" Click="Button_Click"/>

    </StackPanel>
</Page>
