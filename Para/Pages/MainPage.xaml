<Page x:Class="Para.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Para.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage" Background="#FFFFC0CB">

    <Grid>
        <StackPanel>
            <ListBox FontSize="18" Height="Auto" Width="Auto" HorizontalAlignment="Left" SelectionChanged="ListBox_SelectionChanged" Background="#FFFFF0F5">
                <ListBoxItem x:Name="ListBoxItem1">Пицца Вова: из аниме тянок, заправленная соусом (простите) пайтон. Цена:бесконечно денег(100000000000(это доллары))</ListBoxItem>
                <ListBoxItem x:Name="ListBoxItem2">Пицца Масончик: без ГМО халяль. Цена:999.99 рэ</ListBoxItem>
                <ListBoxItem x:Name="ListBoxItem3">Пицца Машко: немношко с шерстью марсе (приятный бонус). Цена:1488 рэ</ListBoxItem>
                <ListBoxItem x:Name="ListBoxItem4">Пицца Алешка: жирная шо пипэц. Цена:0.5 рэ</ListBoxItem>
                <ListBoxItem x:Name="ListBoxItem5">Пицца Коваль: Бих спэшал внутрэ. Цена:555 рэ</ListBoxItem>
            </ListBox>

            <Label FontSize="20" x:Name="tb" Content="Вы выбрали: "/>

            <Button x:Name="ButtonNext" 
         Visibility="Collapsed"
         Content="Следщ" Grid.Column="1" 
         Height="45" Width="230"
         FontSize="20" Background="White"/>
        </StackPanel>
    </Grid>
</Page>
