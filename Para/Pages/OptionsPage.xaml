<Page x:Class="Para.Pages.OptionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Para.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OptionsPage" Background="#FFFFC0CB">

    <StackPanel>
        
        <StackPanel Orientation="Horizontal" Margin="5">

            <StackPanel Orientation="Vertical">
                <TextBlock Text="Выберите размер:" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                <RadioButton x:Name="SmallSize"
                Content="Маленькая (без доплаты)" FontSize="14"
                GroupName="SizeGroup"
                Margin="5" Checked="SmallSize_Checked"/>

            <RadioButton x:Name="AverageSize"
            GroupName="SizeGroup" Margin="5"
            Checked="AverageSize_Checked"
            Content="Средняя (доплата *1.2)" FontSize="19"/>

            <RadioButton x:Name="BigSize" 
            GroupName="SizeGroup" Margin="5" 
            Checked="BigSize_Checked"
            Content="Большая (доплата *1.4)" FontSize="24"/>

            </StackPanel>

            <ComboBox x:Name="DopCB" Background="#FFFFF0F5" Width="250" Height="60" Margin="10" SelectionChanged="DopCB_SelectionChanged">
                <TextBlock x:Name="DopCB1" FontSize="18">сыр +50₽</TextBlock>
                <TextBlock x:Name="DopCB2" FontSize="18">бекон +80₽</TextBlock>
                <TextBlock x:Name="DopCB3" FontSize="18">грибы +40₽</TextBlock>
        </ComboBox>
        
        <Button Content="ВЫБРАЛ ЕТО"
         x:Name="ButtonChoice"
         Height="50" Width="Auto" Margin="10"
         Background="White" Click="ButtonChoice_Click"/>
        </StackPanel>
        
        <Label FontSize="20" x:Name="cb" Content="Вы выбрали: "/>
        <TextBlock Margin="5" Text="Итого:" FontSize="20" FontWeight="Bold" x:Name="itog2"/>

        <Button x:Name="ButtonNext" 
         Content="Оформить" Grid.Column="1"
         Height="45" Width="230"
         FontSize="20" Background="White" Click="ButtonNext_Click"/>
    </StackPanel>
</Page>
