<Page x:Class="Para.ModalWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Para"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ModalWindow" Background="White">

    <StackPanel HorizontalAlignment="Center">
        <Label Content="******" x:Name="Captcha" FontSize="20" HorizontalAlignment="Center"/>
        <TextBox FontSize="20" Width="100" x:Name="CaptchaEnter"/>
        <Button Click="Button_Click1">Подтвердить</Button>
        <Button x:Name="CancelButton" Content="Отмена" IsCancel="True" Margin="5"/>
    </StackPanel>
</Page>
